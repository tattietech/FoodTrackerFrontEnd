@using foodTrackerFrontEnd.ViewModels;
@using foodTrackerFrontEnd.Interfaces;
@using foodTrackerFrontEnd.Models;

@inject AppState AppState;
@implements IDisposable;
@inject IHouseholdService _service;


<MudPaper Width="500px">
    <MudList Clickable="false">
        @if (notificationLoaded)
        {
            if (Invites.Count() > 0)
            {
                foreach (var invite in Invites)
                {
                    <MudListItem Icon="@Icons.Material.Filled.Inbox">
                        @invite.From.GivenName @invite.From.FamilyName has invited you to join their household!
                        @if (invite.Accepted)
                        {
                            <MudText Color="Color.Success">Accepted</MudText>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success" @onclick="@(() => AcceptInvite(invite.Email))">
                                Accept
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Error">
                                Decline
                            </MudButton>
                        }
                    </MudListItem>
                }
            }
            else
            {
                <MudText Class="pt-2 ps-2 pe-2 pb-2">You don't have any notifications!</MudText>
            }
        }
        else
        {
            <MudListItem>
                <MudProgressCircular Class="align-center" Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
            </MudListItem>
        }
    </MudList>
</MudPaper>

@code {
    [Parameter] public List<HouseholdInvite> Invites { get; set; }

    private bool notificationLoaded = false;

    protected override void OnParametersSet()
    {
        notificationLoaded = true;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }

    private async Task AcceptInvite(string inviteId)
    {
        await _service.AcceptInvite(inviteId);
        AppState.OnChange += StateHasChanged;
    }
}
