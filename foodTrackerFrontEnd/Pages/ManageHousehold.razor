@page "/household"
@using foodTrackerFrontEnd.Interfaces;
@using foodTrackerFrontEnd.Models;
@using foodTrackerFrontEnd.Pages.Modals;
@using foodTrackerFrontEnd.ViewModels;
@inject IHouseholdService _householdService;
@inject IDialogService DialogService;
@inject NavigationManager _navigationManager;
@inject IUserService _userService;

@inject AppState AppState
@implements IDisposable

<AuthorizeView>
    <Authorized>
        @if (householdLoading)
        {
            <div class="centered">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            if (AppState.CurrentUser.Households.Count() > 1)
            {
                <MudSelect Value="@selectedHousehold" ValueChanged="@((string value) => SwitchHousehold(value))" Label="Switch Household" Class="mb-4" T="string" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var household in AppState.CurrentUser.Households)
                    {
                        <MudSelectItem Value=household.Id>@household.Name</MudSelectItem>
                    }
                </MudSelect>
                @* <MudButton StartIcon="@Icons.Material.Filled.SwapHoriz" Class="mb-4 mr-2" @onclick="@(() => SwitchHousehold())" Variant="Variant.Filled" Color="Color.Primary">
                    Switch Household
                </MudButton> *@
            }
            if (AppState.CurrentUser.IsHouseholdAdmin(household.Id))
            {
                <MudButton StartIcon="@Icons.Material.Filled.PersonAdd" Class="mb-4" @onclick="@(() => OpenDialog())" Variant="Variant.Filled" Color="Color.Primary">
                    Invite to household
                </MudButton>
            }
            <h1 class="mb-4">@household.Name</h1>
            <h3 class="mb-4">Members -</h3>
            @foreach (var user in household.Users)
            {
                <MudCard Class="mb-4">
                        <MudCardHeader>
                                <CardHeaderContent>
                            @if (user.Email == AppState.CurrentUser.Email)
                                {
                                    <MudText>@user.GivenName @user.FamilyName (You)</MudText>
                                }
                                else
                                {
                                    <MudText>@user.GivenName @user.FamilyName</MudText>
                                }
                                @if (user.IsHouseholdAdmin(household.Id))
                                    {
                                        <MudText Align="Align.Right">Admin</MudText>
                                    }
                                <MudText Typo="Typo.h6">@user.Email</MudText>
                                </CardHeaderContent>
                                @*<CardHeaderActions>
                                    <MudIconButton OnClick="@(() => OpenDialog(storage))" Icon="@Icons.Material.Filled.Edit" Color="Color.Default" />
                                    <MudIconButton OnClick="@(() => ConfirmDelete(storage))" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" />
                                </CardHeaderActions>*@
                            </MudCardHeader>
                        </MudCard>
            }
        }
    </Authorized>
    <NotAuthorized>
        Welcome to Food Expiry Tracker! Please log in to add items
    </NotAuthorized>
</AuthorizeView>

@code {
    protected async override void OnInitialized()
    {
        householdLoading = true;

        AppState.SetAppBarHeading($"Manage Household");

        await _userService.SetCurrentUser();

        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }

    private async void OpenDialog()
    {
        DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = DialogService.Show<SendInvite>("Invite someone to your household", closeOnEscapeKey);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            this.StateHasChanged();
        }
    }


    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    private bool householdLoading = true;

    private Household household = new Household();

    private string selectedHousehold { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var authState = await authenticationStateTask;
        var user = authState.User;

        if (user.Identity.IsAuthenticated)
        {
            household = await _householdService.Get();
        }

        selectedHousehold = household.Id;

        householdLoading = false;

        this.StateHasChanged();
    }

    private async Task SwitchHousehold(string id)
    {
        selectedHousehold = id;
        await _householdService.Switch(id);
        _navigationManager.NavigateTo($"{_navigationManager.BaseUri}household", true);
    }
}
